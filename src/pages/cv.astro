---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content } from '../content/cv.md';
---

<BaseLayout title="CV" current="cv">
  <article class="cv">
    <Content />

    <div class="cv-download">
      <a
        href="/maharrem-ayar-cv-october-2026.pdf"
        target="_blank"
        rel="noopener noreferrer"
      >
        View CV (PDF) ↗
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .cv-download {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color, #ddd);
  }

  .cv-download a {
    color: var(--accent, #8a4938);
    font-weight: 600;
    text-decoration: none;
  }

  .cv-download a:hover {
    text-decoration: underline;
  }
</style>
